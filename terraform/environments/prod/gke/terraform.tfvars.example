# Valores por defecto para ambiente prod - GKE
# IMPORTANTE: NO commitear este archivo con valores reales

# project_id       = "your-production-gcp-project-id"
# credentials_file = "/path/to/production-service-account.json"

cluster_name       = "ecommerce-prod-gke"
region             = "us-central1"
zone               = "us-central1-a"
regional           = true  # Cluster regional para alta disponibilidad
kubernetes_version = "1.28"
release_channel    = "STABLE"

# Network
subnet_cidr   = "10.0.0.0/20"
pods_cidr     = "10.4.0.0/14"
services_cidr = "10.8.0.0/20"

# Private Cluster - Habilitado para producción
enable_private_nodes    = true
enable_private_endpoint = false
master_ipv4_cidr_block  = "172.16.0.0/28"

# Master Authorized Networks - Configurar con tus IPs
# master_authorized_networks = [
#   {
#     cidr_block   = "203.0.113.0/24"
#     display_name = "office-network"
#   }
# ]

# Node Pool - Configuración robusta para producción
machine_type       = "e2-standard-4"
disk_size_gb       = 100
disk_type          = "pd-ssd"
image_type         = "COS_CONTAINERD"
node_count_per_zone = 1  # Total = 3 nodos (1 por zona)
min_node_count     = 3
max_node_count     = 10
auto_repair        = true
auto_upgrade       = true

# Labels
labels = {
  "project" = "ecommerce"
  "env"     = "prod"
}

node_labels = {}
node_tags   = ["gke-node", "ecommerce", "production"]

# Critical Node Pool - HABILITADO para producción
enable_critical_node_pool    = true
critical_machine_type        = "e2-standard-8"
critical_disk_size_gb        = 200
critical_node_count_per_zone = 1
critical_min_node_count      = 2
critical_max_node_count      = 6

# Maintenance
maintenance_start_time = "02:00"

# Addons
enable_http_load_balancing            = true
enable_horizontal_pod_autoscaling     = true
enable_network_policy                 = true
enable_gce_persistent_disk_csi_driver = true

# Logging y Monitoring - Completo para producción
logging_components     = ["SYSTEM_COMPONENTS", "WORKLOADS"]
monitoring_components  = ["SYSTEM_COMPONENTS", "WORKLOADS"]
enable_managed_prometheus = true

# Security - Todo habilitado para producción
enable_binary_authorization = true
enable_secure_boot          = true
enable_integrity_monitoring = true
