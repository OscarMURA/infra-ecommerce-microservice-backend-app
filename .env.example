# Environment Variables Template
# Copy this file to .env and fill in with your actual values

# ================================
# Database Configuration
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_dev
DB_USER=dev_user
DB_PASSWORD=changeme

# ================================
# Redis Configuration
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ================================
# Application Settings
# ================================
NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=debug

# ================================
# JWT Configuration
# ================================
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=24h

# ================================
# Docker Registry
# ================================
DOCKER_REGISTRY_URL=registry.example.com
DOCKER_REGISTRY_USER=your-username
DOCKER_REGISTRY_PASSWORD=your-password

# ================================
# SonarQube Configuration
# ================================
SONAR_HOST_URL=http://sonarqube-vm:9000
SONAR_TOKEN=your-sonarqube-token
SONAR_PROJECT_KEY=ecommerce-microservice-backend

# ================================
# Kubernetes Configuration
# ================================
KUBECONFIG_PATH=~/.kube/config
NAMESPACE=ecommerce-dev

# ================================
# Monitoring
# ================================
ENABLE_MONITORING=true
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# ================================
# External Services
# ================================
# Add any external service URLs or API keys here
