// Jenkins Pipeline para Infraestructura Kubernetes
// Soporta DOKS, GKE y AKS

pipeline {
    agent any
    
    parameters {
        choice(
            name: 'PROVIDER',
            choices: ['doks', 'gke', 'aks'],
            description: 'Proveedor de Kubernetes'
        )
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'prod'],
            description: 'Ambiente a desplegar'
        )
        choice(
            name: 'ACTION',
            choices: ['plan', 'apply', 'destroy'],
            description: 'Acción a ejecutar'
        )
        booleanParam(
            name: 'AUTO_APPROVE',
            defaultValue: false,
            description: 'Aprobar automáticamente (solo dev)'
        )
    }
    
    environment {
        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
        TF_CLI_ARGS = '-no-color'
        WORK_DIR = "terraform/environments/${params.ENVIRONMENT}/${params.PROVIDER}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    // Emoji según el ambiente
                    def envEmoji = params.ENVIRONMENT == 'dev' ? '🔧' : 
                                   params.ENVIRONMENT == 'staging' ? '🎭' : '🚀'
                    
                    echo "${envEmoji} Pipeline iniciado"
                    echo "Provider: ${params.PROVIDER}"
                    echo "Environment: ${params.ENVIRONMENT}"
                    echo "Action: ${params.ACTION}"
                    echo "Workspace: ${env.WORKSPACE}"
                    echo "Working Dir: ${env.WORK_DIR}"
                    
                    // Verificar estructura del workspace
                    sh """
                        echo ""
                        echo "📦 Estructura del workspace:"
                        ls -la
                        echo ""
                        echo "📁 Verificando directorio de trabajo:"
                        ls -la ${env.WORK_DIR} || echo "❌ Directorio no encontrado"
                    """
                }
            }
        }
        
        stage('Setup Credentials') {
            steps {
                script {
                    dir("${env.WORK_DIR}") {
                        if (params.PROVIDER == 'doks') {
                            withCredentials([string(credentialsId: 'digitalocean-token', variable: 'DO_TOKEN')]) {
                                // Solo configurar el token, usar cluster_name del variables.tf
                                writeFile file: 'terraform.tfvars', text: """
do_token = "${DO_TOKEN}"
"""
                            }
                        } else if (params.PROVIDER == 'gke') {
                            withCredentials([
                                string(credentialsId: 'gcp-project-id', variable: 'GCP_PROJECT'),
                                file(credentialsId: 'gcp-service-account', variable: 'GCP_CREDENTIALS')
                            ]) {
                                // Leer el contenido del archivo JSON y copiarlo al directorio de trabajo
                                def credentialsContent = readFile(file: "${GCP_CREDENTIALS}")
                                writeFile file: 'gcp-credentials.json', text: credentialsContent
                                
                                // Configurar variables para Terraform
                                writeFile file: 'terraform.tfvars', text: """
project_id = "${GCP_PROJECT}"
credentials_file = "gcp-credentials.json"
"""
                            }
                        } else if (params.PROVIDER == 'aks') {
                            withCredentials([
                                string(credentialsId: 'azure-subscription-id', variable: 'AZURE_SUBSCRIPTION_ID'),
                                string(credentialsId: 'azure-tenant-id', variable: 'AZURE_TENANT_ID')
                            ]) {
                                // Azure usa la autenticación del Azure CLI ya configurada
                                // Solo necesitamos pasar subscription_id y tenant_id
                                writeFile file: 'terraform.tfvars', text: """
subscription_id = "${AZURE_SUBSCRIPTION_ID}"
tenant_id = "${AZURE_TENANT_ID}"
"""
                                // Verificar autenticación de Azure
                                sh """
                                    echo "🔐 Verificando autenticación de Azure..."
                                    az account show || {
                                        echo "❌ Error: Azure CLI no está autenticado"
                                        exit 1
                                    }
                                    echo "✅ Azure CLI autenticado correctamente"
                                """
                            }
                        }
                    }
                }
            }
        }
        
        stage('Terraform Init') {
            steps {
                script {
                    dir("${env.WORK_DIR}") {
                        // Restaurar estado previo si existe
                        sh """
                            if [ -f /var/lib/jenkins/terraform-states/${params.ENVIRONMENT}/${params.PROVIDER}/terraform.tfstate ]; then
                                echo "📦 Restaurando estado previo de Terraform..."
                                cp /var/lib/jenkins/terraform-states/${params.ENVIRONMENT}/${params.PROVIDER}/terraform.tfstate . || true
                                cp /var/lib/jenkins/terraform-states/${params.ENVIRONMENT}/${params.PROVIDER}/.terraform.lock.hcl . 2>/dev/null || true
                            else
                                echo "ℹ️  No hay estado previo, comenzando desde cero"
                            fi
                        """
                        
                        sh """
                            echo "📁 Directorio actual:"
                            pwd
                            echo ""
                            echo "📄 Archivos en el directorio:"
                            ls -la
                            echo ""
                            echo "🔍 Archivos .tf encontrados:"
                            find . -name "*.tf" -type f || echo "⚠️  No se encontraron archivos .tf"
                            echo ""
                            echo "🔧 Versión de Terraform:"
                            terraform --version
                            echo ""
                            echo "🚀 Inicializando Terraform..."
                            terraform init -upgrade
                            echo ""
                            echo "✅ Validando configuración..."
                            terraform validate
                        """
                    }
                }
            }
        }
        
        stage('Terraform Plan') {
            when {
                expression { params.ACTION == 'plan' || params.ACTION == 'apply' }
            }
            steps {
                script {
                    dir("${env.WORK_DIR}") {
                        sh """
                            terraform plan -out=tfplan
                            terraform show -no-color tfplan > plan.txt
                        """
                        
                        // Publicar el plan
                        archiveArtifacts artifacts: 'plan.txt', fingerprint: true
                        
                        // Mostrar resumen
                        def plan = readFile('plan.txt')
                        echo "📋 Plan Summary:\n${plan.take(500)}..."
                    }
                }
            }
        }
        
        stage('Approval') {
            when {
                expression { 
                    params.ACTION == 'apply' && 
                    (params.ENVIRONMENT == 'prod' || 
                     params.ENVIRONMENT == 'staging' ||
                     !params.AUTO_APPROVE)
                }
            }
            steps {
                script {
                    def approvalMessage = params.ENVIRONMENT == 'prod' ? 
                        '🚨 PRODUCCIÓN - Revisar EXTREMADAMENTE cuidadosamente' : 
                        params.ENVIRONMENT == 'staging' ?
                        '🎭 STAGING - Revisar antes de aplicar' :
                        '🔧 DEV - Revisar y aprobar'
                    
                    def approvalTimeout = params.ENVIRONMENT == 'prod' ? 60 : 30
                    def approvalSubmitter = params.ENVIRONMENT == 'prod' ? 'admin' : 'admin,developer'
                    
                    timeout(time: approvalTimeout, unit: 'MINUTES') {
                        input message: approvalMessage, 
                              ok: 'Aplicar cambios',
                              submitter: approvalSubmitter
                    }
                }
            }
        }
        
        stage('Terraform Apply') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                script {
                    dir("${env.WORK_DIR}") {
                        sh 'terraform apply tfplan'
                    }
                }
            }
        }
        
        stage('Terraform Destroy') {
            when {
                expression { params.ACTION == 'destroy' }
            }
            steps {
                script {
                    // Mensaje según ambiente
                    def destroyMessage = params.ENVIRONMENT == 'prod' ?
                        '🚨🚨🚨 DESTRUIR PRODUCCIÓN - Esta acción NO se puede deshacer' :
                        "�️ DESTRUIR ${params.ENVIRONMENT.toUpperCase()} - Esta acción NO se puede deshacer"
                    
                    timeout(time: 30, unit: 'MINUTES') {
                        input message: destroyMessage, 
                              ok: 'Destruir',
                              submitter: 'admin'
                    }
                    
                    dir("${env.WORK_DIR}") {
                        sh 'terraform destroy -auto-approve'
                    }
                }
            }
        }
        
        stage('Verify Cluster') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                script {
                    dir("${env.WORK_DIR}") {
                        // Guardar outputs
                        sh 'terraform output -json > outputs.json'
                        archiveArtifacts artifacts: 'outputs.json', fingerprint: true
                        
                        // Ejecutar script de verificación según el provider
                        if (params.PROVIDER == 'doks') {
                            withCredentials([string(credentialsId: 'digitalocean-token', variable: 'DIGITALOCEAN_TOKEN')]) {
                                sh """
                                    chmod +x ${env.WORKSPACE}/jenkins/scripts/validate-cluster.sh
                                    export DIGITALOCEAN_TOKEN=\${DIGITALOCEAN_TOKEN}
                                    ${env.WORKSPACE}/jenkins/scripts/validate-cluster.sh ${params.PROVIDER} ${params.ENVIRONMENT}
                                """
                            }
                        } else if (params.PROVIDER == 'gke') {
                            withCredentials([
                                file(credentialsId: 'gcp-service-account', variable: 'GOOGLE_APPLICATION_CREDENTIALS')
                            ]) {
                                sh """
                                    chmod +x ${env.WORKSPACE}/jenkins/scripts/validate-cluster.sh
                                    export GOOGLE_APPLICATION_CREDENTIALS=\${GOOGLE_APPLICATION_CREDENTIALS}
                                    ${env.WORKSPACE}/jenkins/scripts/validate-cluster.sh ${params.PROVIDER} ${params.ENVIRONMENT}
                                """
                            }
                        } else if (params.PROVIDER == 'aks') {
                            sh """
                                chmod +x ${env.WORKSPACE}/jenkins/scripts/validate-cluster.sh
                                ${env.WORKSPACE}/jenkins/scripts/validate-cluster.sh ${params.PROVIDER} ${params.ENVIRONMENT}
                            """
                        }
                    }
                }
            }
        }
        
        stage('Health Check') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                script {
                    // Esperar más tiempo para AKS que necesita inicializar nodos
                    def waitTime = params.PROVIDER == 'aks' ? 90 : 30
                    echo "⏰ Esperando ${waitTime} segundos para que el cluster termine de inicializar..."
                    sleep(time: waitTime, unit: 'SECONDS')
                    
                    // Ejecutar health check según el provider
                    if (params.PROVIDER == 'doks') {
                        withCredentials([string(credentialsId: 'digitalocean-token', variable: 'DIGITALOCEAN_TOKEN')]) {
                            sh """
                                chmod +x ${env.WORKSPACE}/jenkins/scripts/health-check.sh
                                export DIGITALOCEAN_TOKEN=\${DIGITALOCEAN_TOKEN}
                                ${env.WORKSPACE}/jenkins/scripts/health-check.sh ${params.PROVIDER} ${params.ENVIRONMENT}
                            """
                        }
                    } else if (params.PROVIDER == 'gke') {
                        withCredentials([
                            file(credentialsId: 'gcp-service-account', variable: 'GOOGLE_APPLICATION_CREDENTIALS')
                        ]) {
                            sh """
                                chmod +x ${env.WORKSPACE}/jenkins/scripts/health-check.sh
                                export GOOGLE_APPLICATION_CREDENTIALS=\${GOOGLE_APPLICATION_CREDENTIALS}
                                ${env.WORKSPACE}/jenkins/scripts/health-check.sh ${params.PROVIDER} ${params.ENVIRONMENT}
                            """
                        }
                    } else if (params.PROVIDER == 'aks') {
                        sh """
                            chmod +x ${env.WORKSPACE}/jenkins/scripts/health-check.sh
                            ${env.WORKSPACE}/jenkins/scripts/health-check.sh ${params.PROVIDER} ${params.ENVIRONMENT}
                        """
                    }
                }
            }
        }
    }
    
    post {
        success {
            script {
                def successEmoji = params.ENVIRONMENT == 'dev' ? '✅' : 
                                   params.ENVIRONMENT == 'staging' ? '🎉' : '🚀'
                echo "${successEmoji} Pipeline completado exitosamente en ${params.ENVIRONMENT.toUpperCase()}"
                
                if (params.ACTION == 'apply') {
                    dir("${env.WORK_DIR}") {
                        def outputs = sh(script: 'terraform output -json', returnStdout: true)
                        echo "📊 Outputs:\n${outputs}"
                    }
                }
            }
        }
        failure {
            script {
                def errorMsg = "❌ Pipeline falló en ${params.ENVIRONMENT.toUpperCase()}"
                echo errorMsg
                echo "Provider: ${params.PROVIDER}"
                echo "Action: ${params.ACTION}"
                echo "Workspace: ${env.WORKSPACE}"
                echo "Working Dir: ${env.WORK_DIR}"
            }
        }
        always {
            // Limpiar workspace pero PRESERVAR el estado de Terraform
            dir("${env.WORK_DIR}") {
                // Guardar el estado de Terraform antes de limpiar
                sh """
                    mkdir -p /var/lib/jenkins/terraform-states/${params.ENVIRONMENT}/${params.PROVIDER} || true
                    cp -f terraform.tfstate /var/lib/jenkins/terraform-states/${params.ENVIRONMENT}/${params.PROVIDER}/ 2>/dev/null || true
                    cp -f .terraform.lock.hcl /var/lib/jenkins/terraform-states/${params.ENVIRONMENT}/${params.PROVIDER}/ 2>/dev/null || true
                """
            }
            cleanWs()
        }
    }
}
